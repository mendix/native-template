<?xml version="1.0" encoding="utf-8"?>
<!-- Splash window background: the splash image is scaled uniformly to cover the window and
     centered (center-crop, same as scaleAspectFill on the iOS launch screen), so it keeps its
     aspect ratio on every screen size and orientation. The white layer underneath shows through
     transparent pixels (and covers the window if the bitmap fails to decode). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android"
    android:opacity="opaque">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
        </shape>
    </item>
    <item>
        <drawable
            class="com.mendix.nativetemplate.splashscreen.CenterCropDrawable"
            android:src="@drawable/splash" />
    </item>
</layer-list>
