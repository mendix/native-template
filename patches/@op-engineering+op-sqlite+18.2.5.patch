+void OPDatabase::drop() {
+  if (delete_db_name.empty()) {
+    // Remote-only databases have no local file; closing is all we can do.
+    invalidate();
+    return;
+  }
+
+  invalidated = true;
+  // Same sequence as the JS delete() host function: abort running work, drain
+  // the thread pool, then close the handle and remove the file.
+#if !defined(OP_SQLITE_USE_LIBSQL) && !defined(OP_SQLITE_USE_TURSO)
+  if (db != nullptr) {
+    sqlite3_interrupt(db);
+  }
+#endif
+  thread_pool->wait_finished();
+  release_hooks();
+#ifdef OP_SQLITE_USE_LIBSQL
+  opsqlite_libsql_remove(db, delete_db_name, base_path);
+#else
+  auto *closing_db = db;
+  db = nullptr;
+  opsqlite_remove(closing_db, delete_db_name, base_path);
+#endif
+}
+
 OPDatabase::~OPDatabase() { invalidate(); }
 
 } // namespace opsqlite
