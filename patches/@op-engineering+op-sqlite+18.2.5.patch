+// Weak references to every database handed out by open(), so the platform glue
+// can close or delete all of them (e.g. when the host app clears its data).
+// Weak so the registry never extends a database's lifetime past its JS object.
+std::mutex dbs_mutex;
+std::vector<std::weak_ptr<OPDatabase>> dbs;
+
+static void register_db(const std::shared_ptr<OPDatabase> &db) {
+  std::lock_guard<std::mutex> lock(dbs_mutex);
+  dbs.erase(std::remove_if(dbs.begin(), dbs.end(),
+                           [](const std::weak_ptr<OPDatabase> &weak_db) {
+                             return weak_db.expired();
+                           }),
+            dbs.end());
+  dbs.push_back(db);
+}
+
+static std::vector<std::shared_ptr<OPDatabase>> live_dbs() {
+  std::lock_guard<std::mutex> lock(dbs_mutex);
+  std::vector<std::shared_ptr<OPDatabase>> result;
+  for (const auto &weak_db : dbs) {
+    if (auto db = weak_db.lock()) {
+      result.push_back(db);
+    }
+  }
+  dbs.clear();
+  for (const auto &db : result) {
+    dbs.push_back(db);
+  }
+  return result;
+}
+
+void closeAllDbs() {
+  for (const auto &db : live_dbs()) {
+    db->invalidate();
+  }
+}
+
+bool deleteAllDbs() {
+  bool all_deleted = true;
+  for (const auto &db : live_dbs()) {
+    try {
+      db->drop();
+    } catch (const std::exception &e) {
+      LOGE("[op-sqlite] deleteAllDbs failed for a database: %s", e.what());
+      all_deleted = false;
+    }
+  }
+  return all_deleted;
+}
